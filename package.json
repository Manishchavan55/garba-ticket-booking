{
  "name": "kesariya-dandiya-nights",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "test": "npm --workspace backend test",
    "build": "npm --workspace frontend build",
