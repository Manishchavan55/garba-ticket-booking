# Backend environment
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=1mb

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kesariya_dandiya
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Payment provider boundary
# Keep as unconfigured until a production provider is selected.
PAYMENT_PROVIDER=unconfigured

# Admin authentication
# Session cookie is HttpOnly and Secure in production.
ADMIN_SESSION_TTL_HOURS=8
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Development/admin bootstrap only; never commit real values.
ADMIN_BOOTSTRAP_USERNAME=development_admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-local-secret-password
# In production, the bootstrap command also requires:
# ADMIN_BOOTSTRAP_CONFIRM=CREATE_ADMIN
