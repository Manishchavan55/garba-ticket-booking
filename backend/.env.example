# Backend environment
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=1mb

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kesariya_dandiya
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Payment provider boundary
PAYMENT_PROVIDER=phonepe

# PhonePe Standard Checkout (server-side only)
# Use SANDBOX during UAT and PRODUCTION only after PhonePe go-live enablement.
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_REDIRECT_URL=http://localhost:5173/payment/result
# Configure PhonePe Webhook Authentication as SHA (username + password).
PHONEPE_WEBHOOK_USERNAME=your_phonepe_webhook_username
PHONEPE_WEBHOOK_PASSWORD=your_phonepe_webhook_password

# Admin authentication
# Session cookie is HttpOnly and Secure in production.
ADMIN_SESSION_TTL_HOURS=8
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Development/admin bootstrap only; never commit real values.
ADMIN_BOOTSTRAP_USERNAME=development_admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-local-secret-password
# In production, the bootstrap command also requires:
# ADMIN_BOOTSTRAP_CONFIRM=CREATE_ADMIN
